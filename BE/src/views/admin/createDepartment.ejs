<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Department</title>
</head>
<body>
   <aside class="topnav">
        <li><a href="/admin-index">Trang chủ admin</a></li>
        <li><a href="/create-userPage">Tạo tài khoản</a></li>
        <li><a href="/create-departmentPage">Tạo phòng ban</a></li>
        <li><a href="/logout">Đăng xuất</a></li>
    </aside>
    <div class="form-add-new">
        <form action="/create-department" method="POST">
        <fieldset>
            <legend>Form Department</legend>
            <div class="input-group">
                <label>Nhập tên phòng:</label>
                <input type="text" name="department_name">
            </div>
            <div class="input-group">
                <label>Chọn quản lý: </label>
                <select name="manager_id">
                    <option disabled selected value="">-- Chưa có quản lý (Mặc định) --</option>
                                               
                </select>
            </div>
            <div><button class="btn btn-primary" type="submit">Tạo phòng ban</button></div>
        </fieldset>
    </form>
    </div>
</body>
</html>