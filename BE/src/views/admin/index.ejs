<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>List users</title>
</head>
<body>
    <aside class="topnav">
        <li><a href="/create-userPage">Tạo tài khoản</a></li>
        <li><a href="/create-departmentPage">Tạo phòng ban</a></li>
        <li><a href="/logout">Đăng xuất</a></li>
    </aside>

    <h2>Danh sách tài khoản</h2>
    <div>
        <table border="2px" cellspacing="10">
            <thead>
                <th>id</th>
                <th>name</th>
                <th>email</th>
                <th>password</th>
                <th>phone</th>
                <th>role</th>
                <th>Action</th>
            </thead>
            <tbody>
                <% users.forEach(user => { %>
                    <tr>
                        <td><%= user.id %></td>
                        <td><%= user.name %></td>
                        <td><%= user.email %></td>
                        <td><%= user.password %></td>
                        <td><%= user.phone %></td>
                        <td><%= user.role %></td>
                        <td>
                            <a href="/edit-user/<%=user.id%>">Sửa</a>
                            <span>|</span>
                            <a href="/delete-user/<%=user.id%>">Xóa</a>
                            <span>|</span>
                            <form action="/lock/<%=user.id%>" method="POST">
                                <select name="isLock" onchange="this.form.submit()">
                                    <option value="0" <%= user.is_lock == 0 ? 'selected' : '' %> >Mở</option>
                                    <option value="1" <%= user.is_lock == 1 ? 'selected' : '' %> >Khóa(lock)</option>
                                </select>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <h2>Danh sách phòng ban</h2>
    <div>
        <table border="2px" cellspacing="10">
            <thead>
                <th>id</th>
                <th>name</th>
                <th>manager's id</th>
                <th>Action</th>
            </thead>
            <tbody>
                <% departments.forEach(department => { %>
                    <tr>
                        <td><%= department.department_id %></td>
                        <td><%= department.name %></td>
                        <td><%= department.manager_id %></td>
                        <td>
                            <a href="/edit-department/<%=department.department_id%>">Sửa</a>
                            <span>|</span>
                            <a href="/delete-department/<%=department.department_id%>">Xóa</a>
                            <span>|</span>
                            <!-- <form action="/lock/<%=department.id%>" method="POST">
                                <select name="isLock" onchange="this.form.submit()">
                                    
                                </select>
                            </form> -->
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

</body>
</html>

<style>
    .logout{
        background: rgb(255, 97, 97);
        font-weight: bold;
        color: rgb(205, 205, 68);
    }
</style>