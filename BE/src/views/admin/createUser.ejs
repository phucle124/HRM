<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tạo tài khoản</title>
</head>
<body>
    <aside class="topnav">
        <li><a href="/create-userPage">Tạo tài khoản</a></li>
        <li><a href="/create-departmentPage">Tạo phòng ban</a></li>
    </aside>
    <div class="form-add-new">
        <form action="/create-user" method="POST">
        <fieldset>
            <legend>Form User</legend>
            <div class="input-group">
                <label>Nhập tên:</label>
                <input type="text" name="name">
            </div>
            <div class="input-group">
                <label>Nhập địa chỉ email:</label>
                <input type="email" name="email"/>
            </div>
            <div class="input-group">
                <label>Nhập mật khẩu:</label>
                <input type="password" name="password"/>
            </div>
            <div class="input-group">
                <label>Nhập số điện thoại:</label>
                <input type="tel" name="phone">
            </div>
            <div class="input-group">
                <label>Chọn vai trò:</label>
                <select name="role">
                    <option selected disabled value="">- vai trò -</option>
                    <option value="hr">hr</option>
                    <option value="manager">manager</option>
                    <option value="employee">employee</option>  
                </select>
            </div>
            <div><button class="btn btn-primary" type="submit">Tạo tài khoản</button></div>
        </fieldset>
    </form>
    </div>
</body>
</html>