<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nhân viên Phòng: <%= department.name %></title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <h1 class="mb-4">Danh sách Nhân viên - Phòng ban: <strong><%= department.name %></strong></h1>

        <table class="table table-bordered table-hover">
            <thead class="table-light">
                <tr>
                    <th>Mã NV</th>
                    <th>Họ và tên</th>
                    <th>Email</th>
                    <th>Chức vụ</th>
                </tr>
            </thead>
            <tbody>
                <% if(employees && employees.length > 0) { %>
                    <% employees.forEach(emp => { %>
                        <tr>
                            <td><%= emp.employee_id %></td>
                            <td><%= emp.full_name %></td>
                            <td><%= emp.email %></td>
                            <td><%= emp.position || 'Chưa cập nhật' %></td>
                        </tr>
                    <% }) %>
                <% } else { %>
                    <tr>
                        <td colspan="4" class="text-center">Phòng ban này chưa có nhân viên.</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
        <a href="/hr/departments" class="btn btn-secondary mt-3">Quay lại Danh sách Phòng ban</a>
    </div>
</body>
</html>