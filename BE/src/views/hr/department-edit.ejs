<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sửa Phòng ban</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="card">
            <div class="card-header">
                <h2>Form Sửa thông tin Phòng ban</h2>
            </div>
            <div class="card-body">
                <% if(department) { %>
                <form action="/hr/departments/edit" method="POST">
                    <input type="hidden" name="department_id" value="<%= department.department_id %>">
                    
                    <div class="mb-3">
                        <label for="name" class="form-label">Tên Phòng ban:</label>
                        <input type="text" id="name" name="name" class="form-control" value="<%= department.name %>" required>
                    </div>
                    <div class="mb-3">
                        <label for="manager_id" class="form-label">Trưởng phòng:</label>
                        <select id="manager_id" name="manager_id" class="form-select">
                            <option value="">-- Không chọn --</option>
                            <% if (employees && employees.length > 0) { %>
                                <% employees.forEach(emp => { %>
                                    <option value="<%= emp.employee_id %>" <%= (department.manager_id == emp.employee_id) ? 'selected' : '' %>>
                                        <%= emp.full_name %> (ID: <%= emp.employee_id %>)
                                    </option>
                                <% }) %>
                            <% } %>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success">Cập nhật</button>
                    <a href="/hr/departments" class="btn btn-secondary">Quay lại</a>
                </form>
                <% } else { %>
                    <p class="alert alert-warning">Không tìm thấy thông tin phòng ban.</p>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>